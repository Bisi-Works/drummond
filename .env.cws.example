# Credenciais do `pnpm release` para a Chrome Web Store. Copie para `.env.cws` (ignorado pelo git).
# Não são PLASMO_PUBLIC_*: nunca entram na extensão. Passo a passo em docs/chrome-web-store.md.

# Painel da loja → Conta (ou Publisher → Settings): "Publisher ID".
CWS_PUBLISHER_ID=
# ID da extensão (32 letras), na URL do item no painel depois do primeiro envio.
CWS_EXTENSION_ID=

# Cliente OAuth do Google Cloud (tipo "Aplicativo da Web") e o refresh token gerado no OAuth
# Playground com o escopo https://www.googleapis.com/auth/chromewebstore.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Alternativa ao OAuth: um access token pronto (ex.: de uma conta de serviço via
# `gcloud auth print-access-token --impersonate-service-account=... --scopes=https://www.googleapis.com/auth/chromewebstore`).
# Dura ~1 hora; quando preenchido, as três variáveis acima são ignoradas.
CWS_ACCESS_TOKEN=
