# Copie para `.env` e preencha. Todas as variáveis PLASMO_PUBLIC_* são embutidas no bundle da
# extensão: use uma chave dedicada do OpenRouter, com limite de crédito.
PLASMO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-...

# Revisão e coaching usam o DeepSeek V4 Flash (IDs em https://openrouter.ai/models). Cada tarefa
# tem as suas variáveis, para dar para trocar uma sem mexer na outra. Os valores abaixo são os
# padrões do código: só precisa listar o que quiser mudar.
#
# TEMPERATURE: número, ou "none" para não enviar (use "none", não vazio: o Plasmo ignora vazio).
# REASONING: off | minimal | low | medium | high | default (= não envia). O DeepSeek V4 raciocina
#   em esforço alto por padrão, o que multiplica o tempo de resposta: por isso "off".
# RESPONSE_FORMAT: json_schema (o provedor garante o formato) ou json_object (só garante um JSON;
#   o formato vem do prompt). json_object é para modelos sem provedor com structured outputs.
# PROVIDER_ORDER: provedores a tentar primeiro, separados por vírgula; se falharem, o OpenRouter
#   tenta os demais. "default" deixa o OpenRouter escolher (prioriza os mais baratos, que podem
#   estar lentos ou degradados). Veja o README.
# As requisições usam require_parameters: enviar um parâmetro que o modelo não aceita dá 404.

# Revisão do rascunho: roda a cada mensagem, precisa ser rápida.
PLASMO_PUBLIC_REVIEW_MODEL=deepseek/deepseek-v4-flash-0731
PLASMO_PUBLIC_REVIEW_TEMPERATURE=0.3
PLASMO_PUBLIC_REVIEW_REASONING=off
PLASMO_PUBLIC_REVIEW_RESPONSE_FORMAT=json_schema
PLASMO_PUBLIC_REVIEW_PROVIDER_ORDER=cohere,parasail

# Coaching da conversa: a resposta chega em streaming no painel.
PLASMO_PUBLIC_COACH_MODEL=deepseek/deepseek-v4-flash-0731
PLASMO_PUBLIC_COACH_TEMPERATURE=0.3
PLASMO_PUBLIC_COACH_REASONING=off
PLASMO_PUBLIC_COACH_RESPONSE_FORMAT=json_schema
PLASMO_PUBLIC_COACH_PROVIDER_ORDER=cohere,parasail

# Relatório diário: roda uma vez por dia sobre o resumo do que foi acumulado no tracking, por
# isso pode ser mais caro que a revisão (que roda a cada mensagem).
PLASMO_PUBLIC_REPORT_MODEL=deepseek/deepseek-v4-flash-0731
PLASMO_PUBLIC_REPORT_TEMPERATURE=0.3
PLASMO_PUBLIC_REPORT_REASONING=off
PLASMO_PUBLIC_REPORT_RESPONSE_FORMAT=json_schema
PLASMO_PUBLIC_REPORT_PROVIDER_ORDER=cohere,parasail

# Quantas mensagens anteriores da conversa vão como contexto para a revisão.
PLASMO_PUBLIC_CONTEXT_MESSAGES=20

# Trava do relatório diário: quantos relatórios por dia cada vendedor pode gerar em produção.
# Padrão 1 (o custo previsto do recurso); use outro número só se o time decidir liberar mais.
PLASMO_PUBLIC_REPORT_LIMIT_PER_DAY=1

# true = ignora a trava diária. Serve só para homologação; em `pnpm dev` a trava já fica livre
# automaticamente (NODE_ENV=development), então não precisa marcar isto para testar.
PLASMO_PUBLIC_REPORT_UNLIMITED=false

# true = só usa provedores que não retêm/treinam com os dados (conversas têm dados de clientes).
PLASMO_PUBLIC_DENY_DATA_COLLECTION=true
